/**
 * Endpoint: POST /api/contract/send
 * Descrição: Envia o contrato de participação para a marca assinar digitalmente
 */
async function sendContractToSign(req, res) {
  try {
    const { brandId, email, brandName, cnpj, segment, contractValue, furniture } = req.body;

    // Validações
    if (!brandId || !email || !brandName) {
      return json(res, 400, { error: 'Missing required fields: brandId, email, brandName' });
    }

    // 1. Preparar dados do contrato
    const contractData = {
      brandId,
      email,
      brandName,
      cnpj,
      segment,
      contractValue: formatMoney(contractValue),
      furniture,
      createdAt: new Date().toISOString(),
      status: 'pending_signature'
    };

    // 2. Gerar link Contractktor (mock - substituir com integração real)
    const contractktorLink = await generateContractktorLink(contractData);

    // 3. Preparar template do email
    const emailTemplate = await prepareContractEmail(contractData, contractktorLink);

    // 4. Enviar email
    const emailSent = await sendEmail({
      to: email,
      subject: '🎉 Carandaí 25 - Contrato de Participação para Assinatura Digital',
      html: emailTemplate,
      from: 'carandai25comercial@gmail.com'
    });

    if (!emailSent) {
      return json(res, 500, { error: 'Failed to send contract email' });
    }

    // 5. Registrar no banco de dados
    await db.run(`
      INSERT INTO contracts (brand_id, email, brand_name, cnpj, segment, value, furniture, 
                            contractktor_link, status, sent_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      brandId, email, brandName, cnpj, segment, contractValue, 
      JSON.stringify(furniture), contractktorLink, 'pending_signature', new Date()
    ]);

    // 6. Registrar log
    console.log(`✅ Contract sent to ${email} for ${brandName}`);

    return json(res, 200, {
      ok: true,
      message: 'Contract email sent successfully',
      contractId: brandId,
      status: 'pending_signature',
      contractktorLink
    });

  } catch (error) {
    console.error('❌ Error sending contract:', error);
    return json(res, 500, { error: error.message });
  }
}

/**
 * Gerar link Contractktor para assinatura
 * Integração com plataforma: www.contractktor.com.br
 */
async function generateContractktorLink(contractData) {
  try {
    // TODO: Integrar com API Contractktor
    // Esta é a estrutura de integração esperada:
    
    const contractktorApiKey = process.env.CONTRACTKTOR_API_KEY;
    const contractktorAccountId = process.env.CONTRACTKTOR_ACCOUNT_ID;
    
    if (!contractktorApiKey || !contractktorAccountId) {
      console.warn('⚠️ Contractktor credentials not configured. Using mock link.');
      return `https://contractktor.com.br/sign/demo/${contractData.brandId}`;
    }

    // Chamada real para API Contractktor (quando integração estiver pronta)
    const response = await fetch('https://api.contractktor.com.br/v1/contracts', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${contractktorApiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        type: 'carandai25_participation',
        signers: [
          {
            email: contractData.email,
            name: contractData.brandName,
            role: 'CONTRATANTE'
          }
        ],
        metadata: {
          brandId: contractData.brandId,
          segment: contractData.segment,
          value: contractData.contractValue
        },
        redirectUrl: `https://portal.carandai25.com/contract/status/${contractData.brandId}`
      })
    });

    if (!response.ok) {
      throw new Error(`Contractktor API error: ${response.statusText}`);
    }

    const data = await response.json();
    return data.signUrl; // URL de assinatura digital

  } catch (error) {
    console.error('Error generating Contractktor link:', error);
    throw error;
  }
}

/**
 * Preparar template do email com contrato
 */
async function prepareContractEmail(contractData, contractktorLink) {
  try {
    const template = await readFile('./email-templates/contract-send.html', 'utf8');

    // Mapear dados do contrato para o template
    let html = template
      .replace(/{{BRAND_NAME}}/g, contractData.brandName || 'Marca')
      .replace(/{{BRAND_CNPJ}}/g, contractData.cnpj || '00.000.000/0000-00')
      .replace(/{{SEGMENT}}/g, contractData.segment || 'Diversos')
      .replace(/{{CONTRACT_VALUE}}/g, contractData.contractValue)
      .replace(/{{CONTRACTKTOR_LINK}}/g, contractktorLink)
      .replace(/{{FURNITURE_DESCRIPTION}}/g, describeFurniture(contractData.furniture))
      .replace(/{{PAYMENT_PLAN}}/g, describePaymentPlan(contractData.contractValue));

    return html;

  } catch (error) {
    console.error('Error preparing contract email:', error);
    throw error;
  }
}

/**
 * Endpoint: GET /api/contract/:brandId/status
 * Descrição: Verificar status da assinatura do contrato
 */
async function getContractStatus(req, res) {
  try {
    const { brandId } = req.params;

    const contract = await db.get(`
      SELECT * FROM contracts WHERE brand_id = ? ORDER BY created_at DESC LIMIT 1
    `, [brandId]);

    if (!contract) {
      return json(res, 404, { error: 'Contract not found' });
    }

    return json(res, 200, {
      ok: true,
      contractId: contract.id,
      status: contract.status, // pending_signature, signed, rejected
      sentAt: contract.sent_at,
      signedAt: contract.signed_at,
      documentUrl: contract.document_url,
      message: getStatusMessage(contract.status)
    });

  } catch (error) {
    console.error('Error getting contract status:', error);
    return json(res, 500, { error: error.message });
  }
}

/**
 * Webhook: POST /api/contract/webhook/contractktor
 * Descrição: Recebe notificação do Contractktor quando contrato é assinado
 */
async function contractktorWebhook(req, res) {
  try {
    const { contractId, status, signatures, documentUrl, signedAt } = req.body;

    // Validar webhook (verificar signature se disponível)
    if (!verifyContractktorSignature(req)) {
      return json(res, 401, { error: 'Invalid webhook signature' });
    }

    // Atualizar status do contrato
    await db.run(`
      UPDATE contracts 
      SET status = ?, signed_at = ?, document_url = ?, signatures = ?
      WHERE brand_id = ?
    `, [status, signedAt, documentUrl, JSON.stringify(signatures), contractId]);

    console.log(`✅ Contract ${contractId} webhook received: ${status}`);

    // Se contrato foi assinado com sucesso
    if (status === 'signed') {
      await onContractSigned(contractId);
    }

    return json(res, 200, { ok: true, message: 'Webhook received' });

  } catch (error) {
    console.error('Error processing Contractktor webhook:', error);
    return json(res, 500, { error: error.message });
  }
}

