/**
 * Endpoint: POST /api/account/reset-password-request
 * Descrição: Solicitar reset de senha (se esqueceu)
 */
async function resetPasswordRequest(req, res) {
  try {
    const { email } = req.body;

    if (!email) {
      return json(res, 400, { error: 'Email is required' });
    }

    // Buscar marca pelo email
    const brand = await db.get('SELECT id, email, name FROM brands WHERE email = ?', [email]);

    if (!brand) {
      // Não revelar se email existe ou não (segurança)
      return json(res, 200, {
        ok: true,
        message: 'If the email exists, a reset link will be sent shortly'
      });
    }

    // Gerar token de reset (válido por 1 hora)
    const crypto = require('crypto');
    const resetToken = crypto.randomBytes(32).toString('hex');
    const resetTokenHash = crypto.createHash('sha256').update(resetToken).digest('hex');
    const expiresAt = new Date(Date.now() + 3600000); // 1 hora

    // Salvar token no banco
    await db.run(
      'INSERT INTO password_resets (brand_id, token_hash, expires_at, created_at) VALUES (?, ?, ?, ?)',
      [brand.id, resetTokenHash, expiresAt, new Date()]
    );

    // Enviar email com link de reset
    const resetLink = `https://portal.carandai25.com/reset-password?token=${resetToken}&email=${encodeURIComponent(email)}`;

    const emailTemplate = `
    <!DOCTYPE html>
    <html>
    <head><meta charset="UTF-8"><title>Reset de Senha</title></head>
    <body>
      <h2>Solicitude de Reset de Senha</h2>
      <p>Olá ${brand.name},</p>
      <p>Você solicitou um reset de senha. Clique no link abaixo para criar uma nova senha:</p>
      <p><a href="${resetLink}" style="background: #f0642d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;">Resetar Senha</a></p>
      <p>Este link expira em 1 hora.</p>
      <p>Se você não solicitou, ignore este email.</p>
    </body>
    </html>
    `;

    await sendEmail({
      to: email,
      subject: '🔐 Reset de Senha - Carandaí 25',
      html: emailTemplate
    });

    console.log(`✅ Password reset email sent to ${email}`);

    return json(res, 200, {
      ok: true,
      message: 'Password reset email sent successfully'
    });

  } catch (error) {
    console.error('Error requesting password reset:', error);
    return json(res, 500, { error: 'Failed to process password reset request' });
  }
}

/**
 * Helper: Obter IP do cliente
 */
function getClientIp(req) {
  return req.headers['x-forwarded-for']?.split(',')[0].trim() ||
         req.connection.remoteAddress ||
         req.socket.remoteAddress ||
         req.ip ||
         'unknown';
}

