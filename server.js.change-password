/**
 * Endpoint: POST /api/account/change-password
 * Descrição: Permite que a marca altere sua senha de acesso
 * Autenticação: Requerida (JWT)
 */
async function changePassword(req, res) {
  try {
    const { currentPassword, newPassword } = req.body;
    const userId = req.user?.id; // Do JWT token

    // Validações básicas
    if (!currentPassword || !newPassword) {
      return json(res, 400, { error: 'Missing currentPassword or newPassword' });
    }

    if (newPassword.length < 8) {
      return json(res, 400, { error: 'New password must be at least 8 characters' });
    }

    // Validar complexidade (deve ter números e caracteres especiais)
    const hasNumbers = /[0-9]/.test(newPassword);
    const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};:'",.<>?/\\|`~]/.test(newPassword);

    if (!hasNumbers || !hasSpecial) {
      return json(res, 400, { 
        error: 'Password must contain numbers and special characters (!@#$%^&*)' 
      });
    }

    // Buscar usuário no banco
    const user = await db.get('SELECT * FROM brands WHERE id = ?', [userId]);

    if (!user) {
      return json(res, 401, { error: 'User not found' });
    }

    // Verificar senha atual
    const crypto = require('crypto');
    const currentPasswordHash = crypto
      .createHash('sha256')
      .update(currentPassword + user.salt)
      .digest('hex');

    if (currentPasswordHash !== user.password_hash) {
      console.log(`⚠️ Failed password change attempt for ${user.email}`);
      return json(res, 401, { error: 'Current password is incorrect' });
    }

    // Gerar novo hash de senha
    const newSalt = crypto.randomBytes(16).toString('hex');
    const newPasswordHash = crypto
      .createHash('sha256')
      .update(newPassword + newSalt)
      .digest('hex');

    // Atualizar senha no banco
    await db.run(
      'UPDATE brands SET password_hash = ?, salt = ?, updated_at = ? WHERE id = ?',
      [newPasswordHash, newSalt, new Date(), userId]
    );

    // Registrar log de auditoria
    await db.run(
      'INSERT INTO audit_log (user_id, action, details, ip_address, created_at) VALUES (?, ?, ?, ?, ?)',
      [userId, 'PASSWORD_CHANGED', 'Brand changed their password', getClientIp(req), new Date()]
    );

    // Enviar email de confirmação
    await sendPasswordChangeEmail(user.email, user.name);

    console.log(`✅ Password changed successfully for ${user.email}`);

    return json(res, 200, {
      ok: true,
      message: 'Password changed successfully. A confirmation email has been sent.'
    });

  } catch (error) {
    console.error('❌ Error changing password:', error);
    return json(res, 500, { error: 'Failed to change password' });
  }
}

