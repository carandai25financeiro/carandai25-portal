// INTEGRAÇÃO NO BANCO DE DADOS (SQLite)
// ============================================================================

// SQL para criar tabela de audit log
const CREATE_AUDIT_LOG_TABLE = `
CREATE TABLE IF NOT EXISTS audit_log (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id TEXT NOT NULL,
  action TEXT NOT NULL,
  details TEXT,
  ip_address TEXT,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (user_id) REFERENCES brands(id)
);
`;

// SQL para criar tabela de password resets
const CREATE_PASSWORD_RESETS_TABLE = `
CREATE TABLE IF NOT EXISTS password_resets (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  brand_id TEXT NOT NULL,
  token_hash TEXT NOT NULL UNIQUE,
  used INTEGER DEFAULT 0,
  expires_at DATETIME NOT NULL,
  used_at DATETIME,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (brand_id) REFERENCES brands(id)
);
`;

// Executar ao inicializar o servidor
db.run(CREATE_AUDIT_LOG_TABLE);
db.run(CREATE_PASSWORD_RESETS_TABLE);

