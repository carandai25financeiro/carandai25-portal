/**
 * Helper: Descrever mobiliário conforme segmento
 */
function describeFurniture(furniture) {
  const furnitureMap = {
    'moda': 'Arara 1,80m x 1,74m + 1 cadeira',
    'acessorio': 'Mesa 1,60m x 0,80m + 1 cadeira',
    'bolsa-sapato': 'Estante 1,80m x 1,74m (5 prateleiras) + 1 cadeira',
    'bem-estar-decor': 'Estante 2,40m x 1,50m (6 prateleiras) + Aparador 1,60m x 0,40m + 1 cadeira',
    'alimentacao': 'Food Truck (regras operacionais especiais)'
  };

  return furnitureMap[furniture] || 'Mobiliário conforme segmento';
}

/**
 * Helper: Descrever plano de pagamento
 */
function describePaymentPlan(value) {
  const total = parseFloat(value.replace('R$ ', '').replace(',', '.'));
  const installment = (total / 3).toFixed(2);

  return `
    <ul style="margin-left: 20px;">
      <li>1ª parcela: R$ ${installment} - Vencimento: 30/08/2026</li>
      <li>2ª parcela: R$ ${installment} - Vencimento: 15/10/2026</li>
      <li>3ª parcela: R$ ${installment} - Vencimento: A confirmar</li>
    </ul>
    Forma de pagamento: Boleto Bancário ou PIX
  `;
}

/**
 * Helper: Mensagem de status
 */
function getStatusMessage(status) {
  const messages = {
    'pending_signature': '⏳ Aguardando sua assinatura digital no Contractktor',
    'signed': '✅ Contrato assinado com sucesso!',
    'rejected': '❌ Assinatura rejeitada. Entre em contato conosco.',
    'expired': '⏰ Link de assinatura expirado. Solicite um novo.'
  };
  return messages[status] || 'Status desconhecido';
}

/**
 * Helper: Formatar dinheiro
 */
function formatMoney(value) {
  return new Intl.NumberFormat('pt-BR', {
    style: 'currency',
    currency: 'BRL'
  }).format(value);
}

