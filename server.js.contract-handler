      to: contract.email,
      subject: '✅ Contrato Assinado - Carandaí 25',
      html: await prepareContractSignedEmail(contract),
      from: 'carandai25comercial@gmail.com'
    });

    // 3. Enviar email interno (comercial + financeiro)
    await sendEmail({
      to: 'carandai25comercial@gmail.com,financeiro2@carandai25.com',
      cc: 'ops@carandai25.com',
      subject: `📋 Contrato Assinado: ${contract.brand_name}`,
      html: `
        <h3>Novo Contrato Assinado</h3>
        <p><strong>Marca:</strong> ${contract.brand_name}</p>
        <p><strong>Email:</strong> ${contract.email}</p>
        <p><strong>Segmento:</strong> ${contract.segment}</p>
        <p><strong>Valor:</strong> R$ ${contract.value}</p>
        <p><strong>Assinado em:</strong> ${contract.signed_at}</p>
        <p><a href="https://portal.carandai25.com/contract/${brandId}">Ver no Portal</a></p>
      `,
      from: 'carandai25comercial@gmail.com'
    });

    // 4. Atualizar status no portal (dashboard da marca)
    console.log(`✅ Notifications sent for signed contract: ${brandId}`);

  } catch (error) {
    console.error('Error on contract signed:', error);
  }
}

